# ─────────────────────────────────────────────────────
#  WinXP Activity — Root .env (used by both client & server in local dev)
#  Copy to .env and fill in your values.
#
#  PRODUCTION DEPLOYMENT:
#   - Vercel (client): set VITE_CLIENT_ID and VITE_SERVER_URL in
#     Vercel → Project → Settings → Environment Variables
#   - Pterodactyl (server): set PORT, NODE_ENV, VITE_CLIENT_ID,
#     CLIENT_SECRET in the panel's Startup → Environment Variables
#   See PTERODACTYL.md for the full deployment guide.
# ─────────────────────────────────────────────────────

# Discord application Client ID (visible, safe to commit to client bundles)
VITE_CLIENT_ID=your_discord_client_id_here

# Discord application Client Secret (server-only — never expose to client)
CLIENT_SECRET=your_discord_client_secret_here

# ── Production-only ──────────────────────────────────
# Set this on Vercel so the client connects directly to your Pterodactyl
# server without any /config round-trip. Use the public HTTPS URL.
# VITE_SERVER_URL=https://goatpanel.duckdns.org:3002

# Set this on the Pterodactyl server if you want the /config endpoint
# to probe an external Colyseus instance. Leave unset when Pterodactyl
# IS the Colyseus server (normal case).
# EXTERNAL_SERVER_URL=https://goatpanel.duckdns.org:3002

# Port for the Colyseus server (Pterodactyl sets this automatically)
# PORT=3002

# Node environment (set to "production" on Pterodactyl)
# NODE_ENV=production
