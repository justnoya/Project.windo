{
  "name": "template-discord-colyseus-phaser-server",
  "version": "0.0.1",
  "description": "Colyseus + Express game server for WinXP Activity",
  "main": "dist/server.js",
  "scripts": {
    "build": "npm run build:clean && npm run build:tsc",
    "build:clean": "node -e \"const fs=require('fs');const p='./dist';if(fs.existsSync(p)){fs.rmSync(p,{recursive:true})}fs.mkdirSync(p,{recursive:true})\"",
    "build:tsc": "tsc",
    "serve": "node ./dist/server.js",
    "start": "npm run build && npm run serve",
    "dev": "nodemon --watch src -e ts --exec \"npm run build && npm run serve\""
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@colyseus/core": "^0.17.43",
    "@colyseus/monitor": "^0.17.8",
    "@colyseus/schema": "^4.0.0",
    "@colyseus/ws-transport": "^0.17.13",
    "dotenv": "^16.0.1",
    "express": "^4.17.1",
    "http-proxy-middleware": "^2.0.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.11",
    "@types/node": "^20.12.11",
    "nodemon": "^3.0.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  }
}
