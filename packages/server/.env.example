# ─────────────────────────────────────────────────────
#  WinXP Activity — Colyseus Server Environment
#  Copy this to .env and fill in your values.
#  Set these same variables inside Pterodactyl Panel
#  under Server → Startup → Environment Variables.
# ─────────────────────────────────────────────────────

# The port Pterodactyl assigns to this server.
# Match exactly what you see in your Pterodactyl egg.
PORT=3002

# Must be "production" on Pterodactyl.
NODE_ENV=production

# Your Discord application's Client ID (from Discord Developer Portal).
# This is the same value as VITE_CLIENT_ID used by the client.
VITE_CLIENT_ID=your_discord_client_id_here

# Your Discord application's Client Secret (from Discord Developer Portal).
# Keep this private — never commit it to git.
CLIENT_SECRET=your_discord_client_secret_here

# Optional: restrict CORS to specific origins (comma-separated).
# Set to your Vercel domain to lock down the server in production.
# If not set, all origins are allowed (fine for Discord Activity proxy).
# CORS_ORIGIN=https://your-app.vercel.app,https://discord.com

# Optional: only needed if you run the Colyseus server on a SEPARATE
# machine from the Express API. Leave this unset when this server IS
# the Colyseus server (which is the normal setup on Pterodactyl).
# EXTERNAL_SERVER_URL=https://other-server.example.com:3002
